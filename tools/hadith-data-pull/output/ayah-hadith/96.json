openiti:0261Muslim.Sahih.Shamela0001727-ara1:615","test":"label","quote":"اقرأ باسم ربك الذي خلق خلق الإنسان من علق اقرأ وربك الأكرم الذي علم بالقلم علم الإنسان ما لم يعلم"}],"5":[{"book":"0241IbnHanbal.Musnad.Shamela0025794-ara1","n":25743,"number":25959,"standard":25959,"openitiId":"openiti:0241IbnHanbal.Musnad.Shamela0025794-ara1:25743","test":"label","quote":"ما لم يعلم"},{"book":"0256Bukhari.Sahih.JK000110-ara1","n":5188,"number":4953,"standard":4953,"openitiId":"openiti:0256Bukhari.Sahih.JK000110-ara1:5188","test":"words","quote":"علم لنسن م لم يعلم"},{"book":"0256Bukhari.Sahih.JK000110-ara1","n":7275,"number":6982,"standard":6982,"openitiId":"openiti:0256Bukhari.Sahih.JK000110-ara1:7275","test":"words","quote":"علم لنسن م لم يعلم"}],"7":[{"book":"0241IbnHanbal.Musnad.Shamela0025794-ara1","n":8491,"number":8831,"standard":8831,"openitiId":"openiti:0241IbnHanbal.Musnad.Shamela0025794-ara1:8491","test":"label","quote":"إن الإنسان ليطغى أن رآه استغنى إن إلى ربك الرجعى أرأيت الذي ينهى عبدا إذا صلى أرأيت إن كان على الهدى أو أمر بالتقوى أرأيت إن كذب وتولى"},{"book":"0261Muslim.Sahih.Shamela0001727-ara1","n":13211,"number":2797,"standard":7065,"openitiId":"openiti:0261Muslim.Sahih.Shamela0001727-ara1:13211","test":"label","quote":"كلا إن الإنسان ليطغى، أن رآه استغنى إن إلى ربك الرجعى، أرأيت الذي ينهى، عبدا إذا صلى، أرأيت إن كان على الهدى، أو أمر بالتقوى، أرأيت إن كذب وتولى"}],"10":[{"book":"0241IbnHanbal.Musnad.Shamela0025794-ara1","n":2747,"number":3044,"standard":3044,"openitiId":"openiti:0241IbnHanbal.Musnad.Shamela0025794-ara1:2747","test":"label","quote":"أرأيت الذي ينهى عبدا إذا صلى أرأيت إن كان على الهدى أو أمر بالتقوى أرأيت إن كذب وتولى"}],"14":[{"book":"0241IbnHanbal.Musnad.Shamela0025794-ara1","n":8491,"number":8831,"standard":8831,"openitiId":"openiti:0241IbnHanbal.Musnad.Shamela0025794-ara1:8491","test":"label","quote":"ألم يعلم بأن الله يرى كلا لئن لم ينته لنسفعا بالناصية ناصية كاذبة خاطئة فليدع ناديه"},{"book":"0261Muslim.Sahih.Shamela0001727-ara1","n":13211,"number":2797,"standard":7065,"openitiId":"openiti:0261Muslim.Sahih.Shamela0001727-ara1:13211","test":"label","quote":"ألم يعلم بأن الله يرى، كلا لئن لم ينته لنسفعا بالناصية، ناصية كاذبة خاطئة، فليدع ناديه سندع الزبانية، كلا لا تطعه"}],"17":[{"book":"0261Muslim.Sahih.Shamela0001727-ara1","n":13211,"number":2797,"standard":7065,"openitiId":"openiti:0261Muslim.Sahih.Shamela0001727-ara1:13211","test":"label","quote":"فليدع ناديه"}],"18":[{"book":"0241IbnHanbal.Musnad.Shamela0025794-ara1","n":8491,"number":8831,"standard":8831,"openitiId":"openiti:0241IbnHanbal.Musnad.Shamela0025794-ara1:8491","test":"label","quote":"سندع الزبانية"}],"19":[{"book":"0241IbnHanbal.Musnad.Shamela0025794-ara1","n":8491,"number":8831,"standard":8831,"openitiId":"openiti:0241IbnHanbal.Musnad.Shamela0025794-ara1:8491","test":"label","quote":"كلا لا تطعه واسجد واقترب"}]}